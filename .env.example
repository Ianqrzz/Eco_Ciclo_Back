# Copie para .env e preencha. O .env NAO deve ser commitado.
# Conexao pelo pooler do Supabase (Project Settings > Database > Connection pooling)
DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.<id-do-projeto>
DB_PASSWORD=<sua-senha>
CORS_ALLOWED_ORIGINS=http://localhost:5173
